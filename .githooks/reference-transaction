#!/usr/bin/env bash
# Fleet ref-delete guard wrapper (AIH-zgwrk). ai-harness's install writes this file and its
# fallback into every repo under the projects root; edit the source in ai-harness
# (.githooks/fleet/reference-transaction), never a deployed copy.
#
# It runs ai-harness's LIVE guard, so a guard fix reaches every repo the moment ai-harness's
# main tree has it, with no copy to drift. ai-harness is found through the global
# `aih.harnessRoot` (install writes it), then `$PROJECTS_DIR/ai-harness`; never a relative path,
# which breaks from a linked worktree. If neither resolves it warns loudly and runs the
# fallback copy beside it, which install refreshes, so a missing ai-harness never disables
# the guard and never makes one repo depend on another.
#
# Only the `prepared` phase can veto, and the guard exits 0 for every other one, so the wrapper
# does too: otherwise a missing ai-harness would warn three times per ref update.
[[ "${1:-}" == prepared ]] || exit 0
root=$(git config --global --type=path --get aih.harnessRoot 2>/dev/null </dev/null || true)
for candidate in "$root" "${PROJECTS_DIR:+$PROJECTS_DIR/ai-harness}"; do
  if [[ -n "$candidate" && -x "$candidate/.githooks/reference-transaction" ]]; then
    exec "$candidate/.githooks/reference-transaction" "$@"
  fi
done
echo "ref-delete guard: ai-harness not found (aih.harnessRoot=${root:-unset}," \
  "PROJECTS_DIR=${PROJECTS_DIR:-unset}); running this repo's fallback copy. This is" \
  "probably a broken install: re-run ai-harness's install.sh." >&2
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [[ -x "$here/reference-transaction-fallback" ]]; then
  exec "$here/reference-transaction-fallback" "$@"
fi
top=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [[ -n "$top" && -x "$top/.githooks/reference-transaction-fallback" ]]; then
  exec "$top/.githooks/reference-transaction-fallback" "$@"
fi
echo "ref-delete guard: no fallback copy either; refusing the transaction." >&2
exit 1
